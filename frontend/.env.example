# Which Sui network to connect to: devnet | testnet | mainnet
VITE_SUI_NETWORK=testnet

# Fill this in after publishing the contract:
#   cd contract && sui client publish --gas-budget 100000000
# The CLI prints a "Published Objects" section with the package ID.
VITE_PACKAGE_ID=0xPUT_YOUR_PUBLISHED_PACKAGE_ID_HERE

# --- Gonka Router -----------------------------------------------------
# CONFIRM these against the official Gonka docs / MCP tool before your
# demo — see the warning at the top of src/lib/gonka.ts. These are the
# OpenAI-compatible-style values this scaffold assumes as a starting point.
VITE_GONKA_BASE_URL=https://api.gonkarouter.io/v1
VITE_GONKA_API_KEY=
VITE_GONKA_MODEL_A=minimax
VITE_GONKA_MODEL_B=kimi
