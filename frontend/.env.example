# Which Sui network to connect to: devnet | testnet | mainnet
VITE_SUI_NETWORK=testnet

# Fill this in after publishing the contract:
#   cd contract && sui client publish --gas-budget 200000000
# The CLI prints a "Published Objects" section with the package ID. No
# registry object IDs are needed — the contract has no access control, so
# there's nothing else to seed at publish time.
VITE_PACKAGE_ID=0xPUT_YOUR_PUBLISHED_PACKAGE_ID_HERE

# --- Gonka Router -----------------------------------------------------
# GONKA_BASE_URL / GONKA_API_KEY are intentionally NOT VITE_-prefixed — they
# stay server-side (read by api/gonka.ts on Vercel, or the Vite dev-server
# proxy in vite.config.ts locally). See src/lib/gonka.ts for what's been
# confirmed live against gonkarouter.io.
GONKA_BASE_URL=https://api.gonkarouter.io/v1
GONKA_API_KEY=

# Model IDs aren't secret, so these stay client-side. Confirmed working
# live (2026-09-05) with X-Gonka-No-Fallback set: MiniMaxAI/MiniMax-M2.7
# and deepseek-ai/DeepSeek-V4-Flash-0731. moonshotai/Kimi-K2.6 is listed by
# /v1/models but currently has no serving capacity — without the
# no-fallback header it was being silently served by MiniMax instead,
# which broke the two-model cross-check without any visible error. Check
# gonkarouter.io's /models page for your account if these stop working.
VITE_GONKA_MODEL_A=MiniMaxAI/MiniMax-M2.7
VITE_GONKA_MODEL_B=deepseek-ai/DeepSeek-V4-Flash-0731

# Optional: original package that defines Batch/Unit/event types after a compatible upgrade.
# Defaults to VITE_PACKAGE_ID for a fresh deployment.
# VITE_TYPE_PACKAGE_ID=0xORIGINAL_PACKAGE_ID
