# Which Sui network to connect to: devnet | testnet | mainnet
VITE_SUI_NETWORK=testnet

# Fill these in after publishing the contract:
#   cd contract && sui client publish --gas-budget 200000000
# The CLI prints a "Published Objects" / "Created Objects" section with
# the package ID and all four shared registry objects' IDs (types
# `...::batch::RegulatorRegistry`, `...::batch::ManufacturerRegistry`,
# `...::batch::AdminRegistry`, and `...::batch::PharmacyRegistry`) — none
# of these are derivable from the package ID, they're only known from that
# publish output.
VITE_PACKAGE_ID=0xPUT_YOUR_PUBLISHED_PACKAGE_ID_HERE
VITE_REGISTRY_OBJECT_ID=0xPUT_THE_REGULATORREGISTRY_OBJECT_ID_HERE
VITE_MANUFACTURER_REGISTRY_OBJECT_ID=0xPUT_THE_MANUFACTURERREGISTRY_OBJECT_ID_HERE
VITE_ADMIN_REGISTRY_OBJECT_ID=0xPUT_THE_ADMINREGISTRY_OBJECT_ID_HERE
VITE_PHARMACY_REGISTRY_OBJECT_ID=0xPUT_THE_PHARMACYREGISTRY_OBJECT_ID_HERE

# --- Gonka Router -----------------------------------------------------
# GONKA_BASE_URL / GONKA_API_KEY are intentionally NOT VITE_-prefixed — they
# stay server-side (read by api/gonka.ts on Vercel, or the Vite dev-server
# proxy in vite.config.ts locally). See src/lib/gonka.ts for what's been
# confirmed live against gonkarouter.io.
GONKA_BASE_URL=https://api.gonkarouter.io/v1
GONKA_API_KEY=

# Model IDs aren't secret, so these stay client-side. Confirmed working:
# MiniMaxAI/MiniMax-M2.7, moonshotai/Kimi-K2.6 — check gonkarouter.io's
# /models page for your account if these stop working.
VITE_GONKA_MODEL_A=MiniMaxAI/MiniMax-M2.7
VITE_GONKA_MODEL_B=moonshotai/Kimi-K2.6
